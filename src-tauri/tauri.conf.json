{
  "build": {
    "distDir": "../src",
    "devPath": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "BattleverseLauncher",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": ["nsis"],
      "identifier": "com.battleverse.launcher",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "target/release/WebView2Loader.dll"
      ],
      "windows": {
        "nsis": {
          "template": "./installer.nsi",
          "installerIcon": "icons/icon.ico",
          "headerImage": "./installer_header.bmp",
          "sidebarImage": "./installer_sidebar.bmp",
          "languages": ["Russian"],
          "displayLanguageSelector": false
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "BATTLEVERSE Launcher",
        "width": 900,
        "height": 620,
        "resizable": false,
        "fullscreen": false
      }
    ]
  }
}
